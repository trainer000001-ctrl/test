{
  "name": "moonwitness-edge-tasks",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/_meta/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moonwitness-edge-tasks-db",
      "database_id": "767b1aca-30ee-4103-a96d-818cf2dd59b6",
    },
  ],
  "vars": {
    "DEFAULT_GITHUB_REPO": "A-L-L-A-H/moonwitness",
  },
}
